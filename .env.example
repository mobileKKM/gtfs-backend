# Copy to .env. Everything but the connections is optional: the values below are the defaults. Durations are seconds.
# Per-feed settings (realtime overrides, stop search namespaces) live in feeds.yml.

# --- both (gtfs-worker and gtfs-api) -------------------------------------------------------------------------------
DATABASE_URL=postgresql://gtfs:gtfs@localhost:55432/gtfs
REDIS_URL=redis://localhost:56379/0
FEEDS_CONFIG=feeds.yml
LOG_LEVEL=INFO
# DB_POOL_MAX_SIZE=10                 # Postgres connections per process (the worker, and each API process); see API_WORKERS

# --- worker (gtfs-worker) ------------------------------------------------------------------------------------------
ARCHIVE_DIR=data/archive
# ARCHIVE_RETENTION_DAYS=30           # zips of retired/failed versions are removed this long after; 0: keep forever
# OSM_STOPS_FILE=data/osm/stops.json  # OSM stop poles for matching shared stops (without the file stops match by position alone)
# OSM_REFRESH_INTERVAL=86400          # the worker downloads the file (Geofabrik) when it is missing or this old; 0: never
STATIC_POLL_INTERVAL=3600
# Realtime defaults; feeds.yml `realtime_poll_interval` / `realtime_max_age` override them per feed.
# REALTIME_POLL_INTERVAL=10
# REALTIME_MAX_AGE=120                # while a realtime file is unchanged, its last data stays live this long
# HTTP_CONNECT_TIMEOUT=10
# HTTP_RETRIES=3                      # attempts per download, including the first
# HTTP_RETRY_DELAY=1.0
# STATIC_DOWNLOAD_TIMEOUT=300
# REALTIME_FETCH_TIMEOUT=15
# VEHICLE_TTL=120                     # how long live data stays in Redis without a newer poll
# TRIP_TTL=600                        # fallback only: trips are removed when they leave the feed
# ALERT_TTL=600
# UNMATCHED_TTL=120
# WATCHDOG_TIMEOUT=600                # a realtime task without a finished poll this long stops the worker
# RETIRE_AT=03:30                     # daily retirement of timetable versions, Europe/Warsaw time

# --- API (gtfs-api) ------------------------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# API_WORKERS=1                       # processes; docker-compose.yml runs 4
# Keep API_WORKERS * (DB_POOL_MAX_SIZE + CATALOG_POOL_MAX_SIZE) + the worker's DB_POOL_MAX_SIZE below Postgres'
# max_connections (100).
# DB_POOL_TIMEOUT=5                   # wait this long for a free connection, then answer 503
# CATALOG_POOL_MAX_SIZE=2             # the catalog's own connections per API process (never shared with requests)
# REDIS_POOL_MAX_SIZE=50
# REDIS_POOL_TIMEOUT=5
# CATALOG_REFRESH_INTERVAL=300        # also reloaded on `static:updated` and when the day changes
# STATIC_LISTENER_RETRY_DELAY=5
# Response cache in Redis, shared by all API processes (0 = off); also the Cache-Control max-age of public responses
# CACHE_TTL_LIVE=10                   # departure boards, trip views; also renewed whenever their realtime data changes
# CACHE_TTL_STATIC=300                # stops, stop search, route shapes
# CACHE_TTL_ALERTS=15
# HEALTH_REALTIME_MAX_AGE=300         # /health `fresh`: older realtime data (or a feed's larger realtime_max_age) is stale
# HEALTH_STATIC_MAX_AGE=10800         # ... and a static feed not checked for this long
